{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ops-staging",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ops-auth-staging",
			"database_id": "b637a69c-e168-4eef-8b27-b9963fb4ace7",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}